# --- Redis (REDIS_URL wins if set; Railway provides it) ---
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Limiter ---
SERVICE_NAME=limiter
ALGORITHM=token_bucket        # token_bucket | leaky_bucket | fixed_window | sliding_window
FAIL_MODE=open                # open = allow when Redis is down, closed = reject (503)
ENABLE_RL=true
RL_UPDATE_INTERVAL_SEC=10
LOG_LEVEL=INFO

# --- Security ---
ADMIN_API_KEY=                # required for /v1/admin/*; generate: openssl rand -hex 32
CORS_ORIGINS=                 # e.g. https://your-dashboard.vercel.app

# --- AI traffic analyst (Claude) ---
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
ANALYST_MAX_PER_HOUR=20

# --- Tracing (optional, any OTLP backend) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
