{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://drl-distributed-rate-limiter-production.up.railway.app/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://drl-distributed-rate-limiter-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
